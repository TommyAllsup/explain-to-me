{
  "name": "explain-to-me",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "explain-to-me": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/*/src/*.test.ts apps/*/src/*.test.ts",
    "test:agent": "node scripts/test-agent.mjs",
    "schema:manifest": "tsx packages/contracts/scripts/write-json-schema.ts"
  },
  "description": "Local-first narrated, captioned explainer videos from documents and reviewed manifests",
  "author": "Tommy Allsup",
  "license": "MIT",
  "homepage": "https://github.com/TommyAllsup/explain-to-me#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TommyAllsup/explain-to-me.git"
  },
  "bugs": { "url": "https://github.com/TommyAllsup/explain-to-me/issues" },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
